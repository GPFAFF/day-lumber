---
// Netlify Forms redirect here after a successful submission (form action="/thanks/").
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import { business } from '../data/site';
---
<Base title="Thank You - Day Lumber" noindex breadcrumb={[{ name: 'Thank You' }]}>
  <PageBanner title="Thank You" />
  <section class="space-top space-extra-bottom">
    <div class="container text-center">
      <h2 class="sec-title">Thanks, we got your message.</h2>
      <p class="mb-4">A member of the Day Lumber team will get back to you. Need an answer sooner? Call <a href={business.phoneHref}>{business.phone}</a>.</p>
      <a class="vs-btn" href="/">Back to Home</a>
    </div>
  </section>
</Base>
