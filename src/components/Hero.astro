---
// Full-width photo hero with heading, tagline and a call-to-action button (landing pages).
interface Props {
  heading: string;
  tagline?: string;
  eyebrow?: string;
  background?: string;
  cta?: { label: string; href: string };
}
const {
  heading,
  tagline,
  eyebrow = 'Day Lumber Company',
  background = '/assets/img/2026/03/pallets.webp',
  cta = { label: 'Contact Now', href: '/contact-us/' },
} = Astro.props;
---
<section class="hero-layout1" data-bg-src={background}>
  <div class="hero-item">
    <div class="container position-relative z-index">
      <div class="row">
        <div class="col-lg-8 position-relative">
          <div class="hero-content">
            <div class="hero-subtitle wow animate__fadeInUp" data-wow-delay="0.30s">{eyebrow}</div>
            <h1 class="hero-title wow animate__fadeInUp" data-wow-delay="0.50s">{heading}</h1>
            {tagline && <p class="hero-text wow animate__fadeInUp" data-wow-delay="0.75s">{tagline}</p>}
            <a class="vs-btn wow animate__fadeInUp" data-wow-delay="0.95s" href={cta.href}>
              {cta.label}<i aria-hidden="true" class="fa-regular fa-arrow-right"></i>
            </a>
            <span class="dot-shape wow animate__bounceInRight" data-wow-delay="0.70s"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-text {
    font-size: 20px;
  }
</style>
