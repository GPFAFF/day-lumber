---
// <title>, description, canonical URL, Open Graph/Twitter tags and JSON-LD for one page.
export interface SeoProps {
  title: string;
  description?: string;
  /** Site-relative image path for social cards. */
  ogImage?: string;
  /** 'article' for Resource posts. */
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  noindex?: boolean;
  /** Breadcrumb trail after Home, e.g. [{ name: 'Resources' }, { name: post title }]. */
  breadcrumb?: { name: string; path?: string }[];
  /** Extra JSON-LD objects (e.g. LocalBusiness on the homepage, FAQPage on landing pages). */
  schema?: Record<string, unknown>[];
}
const { title, description, ogImage = '/assets/img/2026/03/family.jpg', type = 'website', published, modified, noindex, breadcrumb = [], schema = [] } =
  Astro.props;

const site = Astro.site!.origin;
const url = new URL(Astro.url.pathname, site).href;
const image = new URL(ogImage, site).href;
const iso = (d?: Date) => d?.toISOString().replace('.000Z', '+00:00');

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebPage',
    '@id': url,
    url,
    name: title,
    isPartOf: { '@id': `${site}/#website` },
    primaryImageOfPage: { '@id': `${url}#primaryimage` },
    image: { '@id': `${url}#primaryimage` },
    ...(published && { datePublished: iso(published) }),
    ...(modified && { dateModified: iso(modified) }),
    ...(description && { description }),
    breadcrumb: { '@id': `${url}#breadcrumb` },
    inLanguage: 'en-US',
  },
  { '@type': 'ImageObject', inLanguage: 'en-US', '@id': `${url}#primaryimage`, url: image, contentUrl: image },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumb].map((b, i, all) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      ...((b.path || i < all.length - 1) && { item: new URL(b.path ?? Astro.url.pathname, site).href }),
    })),
  },
  { '@type': 'WebSite', '@id': `${site}/#website`, url: `${site}/`, name: 'Day Lumber', description: 'Pallets and skids since 1929', inLanguage: 'en-US' },
];
if (type === 'article') {
  graph.unshift({
    '@type': 'Article',
    '@id': `${url}#article`,
    isPartOf: { '@id': url },
    headline: title,
    ...(published && { datePublished: iso(published) }),
    ...(modified && { dateModified: iso(modified) }),
    mainEntityOfPage: { '@id': url },
    image: { '@id': `${url}#primaryimage` },
    publisher: { '@id': `${site}/#business` },
    inLanguage: 'en-US',
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...graph, ...schema] });
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<link rel="canonical" href={url} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={url} />
<meta property="og:site_name" content="Day Lumber" />
{published && type === 'article' && <meta property="article:published_time" content={iso(published)} />}
{modified && <meta property="article:modified_time" content={iso(modified)} />}
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={jsonLd} />
